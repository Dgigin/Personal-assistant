# DeepSeek API ключ для чата (опционально)
# DEEPSEEK_API_KEY=sk-your-key-here

# GitHub Personal Access Token (только если репозиторий приватный)
# # GITHUB_TOKEN=github_pat_...

# Секретный ключ Flask для подписи сессий
# ВАЖНО: При первой установке будет сгенерирован УНИКАЛЬНЫЙ ключ автоматически.
# Не меняйте __GENERATE_ME__ — скрипт setup_env.py сам заменит его на уникальный ключ.
SECRET_KEY=__GENERATE_ME__

# Аутентификация — ГОСТЕВОЙ логин и пароль
# Администратор может сменить их в этом файле после установки
AUTH_USERNAME=guest
AUTH_PASSWORD=guest
